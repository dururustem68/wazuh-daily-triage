# Copy to .env. Note: docker env_file treats trailing "# comments" as part of the value —
# keep comments on their own lines.

# ---------------------------------------------------------------- web UI
# production | staging | development. In production the app refuses to start with example passwords,
# a missing APP_SECRET, COOKIE_SECURE=false or disabled TLS verification (docs/security-exceptions.md).
ENVIRONMENT=development
APP_PASSWORD=change-me
# Optional read-only viewer password: sign in with it to view everything but change nothing.
VIEWER_PASSWORD=
# Session signing key (openssl rand -hex 32). Empty = sessions are dropped on every restart.
APP_SECRET=
# true if an SSO reverse proxy (Authentik, Keycloak, oauth2-proxy...) already authenticates users
AUTH_DISABLED=false
# Only for a non-standard identity header (comma separated, first non-empty wins). Leaving this empty
# disables header lookup, so keep it commented unless your proxy sends a different name.
# USER_HEADER=X-authentik-username,X-Forwarded-User
# false = no in-process scheduler (manual runs and the UI keep working); use with extra replicas
# WDT_SCHEDULER=true
# true when served over HTTPS
COOKIE_SECURE=false
# Only the reverse proxy's IP; "*" lets clients spoof X-Forwarded-For
FORWARDED_ALLOW_IPS=127.0.0.1
# en | tr
APP_LANGUAGE=en
TZ=UTC
# Link shown in the footer (AGPL-3.0 §13: offer the source to network users). Point it at YOUR fork if you modify the code.
SOURCE_URL=https://github.com/dururustem68/wazuh-daily-triage

# ---------------------------------------------------------------- authorization and audit (docs/permissions.md)
# Environment ids a role may see; empty = all configured environments (comma separated).
ADMIN_ENVS=
VIEWER_ENVS=
# Environments MCP clients may query (empty = all).
MCP_ENVS=
# Operational audit trail (append-only JSONL, hash-chained). Empty = logs/audit.jsonl
AUDIT_LOG_FILE=
# Set to false only for tests: no audit trail (production startup warns).
AUDIT_LOG=true
# Refuse state-changing requests (503) while the audit file cannot be written. Unset = on in production.
# AUDIT_STRICT=true
# Key for personal-data pseudonyms (openssl rand -hex 32). Empty = APP_SECRET; with neither set a random key
# is drawn at every start (safe, but pseudonyms then change on restart). There is no built-in default.
PRIVACY_SALT=
# SSO mode (AUTH_DISABLED=true): who may talk to the application, and whose X-Forwarded-For is believed.
# TRUSTED_PROXIES=10.42.0.0/16        # addresses/CIDRs of the reverse proxy
# PROXY_SECRET=                       # the proxy adds it as the header X-WDT-Proxy-Secret
# SSO_REQUIRE_USER=true               # refuse requests without a user header (default)
# MCP requests per minute and client address (0 = unlimited)
# MCP_RATE_PER_MINUTE=120
# Backup (docs/backup.md): S3 target and the passphrase for AUTOMATIC backups. Manual exports ask for one.
# BACKUP_S3_ENDPOINT=  BACKUP_S3_BUCKET=  BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY=  BACKUP_S3_SECRET_KEY=  BACKUP_S3_PREFIX=wazuh-daily-triage
# BACKUP_PASSPHRASE=
# Extra origins allowed to send state-changing requests, when the public URL differs from the Host /
# X-Forwarded-Host the app sees (comma separated, e.g. https://wdt.example.org).
# WDT_TRUSTED_ORIGINS=
# Prometheus scrape token for /metrics; when empty an admin session is required.
METRICS_TOKEN=
# Bearer token for the MCP endpoint POST /mcp; empty = MCP is disabled (the path answers 404). docs/mcp.md
MCP_TOKEN=
# Deliberate lab overrides of the production startup checks (docs/security-exceptions.md)
# WDT_ALLOW_INSECURE_TLS=1
# WDT_ALLOW_INSECURE_COOKIE=1
# WDT_ALLOW_INSECURE_SMTP=1

# ---------------------------------------------------------------- AI provider (bring your own key)
# anthropic | openai | mock
LLM_PROVIDER=anthropic
# Model id from your provider's documentation
LLM_MODEL=
LLM_API_KEY=
# For the openai provider — see docs/providers.md:
#   OpenAI    https://api.openai.com/v1
#   Gemini    https://generativelanguage.googleapis.com/v1beta/openai
#   DeepSeek  https://api.deepseek.com
#   Ollama    http://ollama:11434/v1   (also vLLM, LM Studio, LiteLLM, full Azure URL)
LLM_BASE_URL=
# Optional tuning. OpenAI reasoning models: LLM_TOKEN_PARAM=max_completion_tokens and LLM_TEMPERATURE=none
LLM_TEMPERATURE=
LLM_TOKEN_PARAM=
LLM_REASONING_EFFORT=
# JSON object passed to the provider verbatim, e.g. {"thinking": {"type": "enabled"}}
LLM_EXTRA_BODY=

# ---------------------------------------------------------------- critical notifications (docs/notifications.md)
# Link target in messages, e.g. https://triage.example.internal
NOTIFY_UI_URL=
NOTIFY_REPEAT_HOURS=24
# true: short summary after every run (default: critical only)
NOTIFY_ON_RUN_SUMMARY=false
NOTIFY_ON_RULE_DEPLOY=true
NOTIFY_ON_LIVENESS=true
# liveness check without AI (minutes, 2-120)
LIVENESS_INTERVAL_MINUTES=10
SMTP_HOST=
SMTP_PORT=587
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# comma separated
SMTP_TO=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TEAMS_WEBHOOK_URL=
# Slack incoming webhook (Your Apps → Incoming Webhooks)
SLACK_WEBHOOK_URL=
# Discord channel webhook (Edit → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=
# Generic JSON webhook (Zapier/Make/SOAR); WEBHOOK_TOKEN → Authorization: Bearer
WEBHOOK_URL=
WEBHOOK_TOKEN=
# ntfy push (https://ntfy.sh/<topic> or full URL); NTFY_TOKEN for a protected topic
NTFY_TOPIC=
NTFY_TOKEN=

# ---------------------------------------------------------------- demo (no Wazuh needed)
WDT_DEMO=false

# ---------------------------------------------------------------- single environment, no YAML needed
# Used only when config/environments.yaml does not exist.
WAZUH_ENV_NAME=Wazuh
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
# optional
WAZUH_API_URL=
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_VERIFY_TLS=true
# e.g. /app/config/certs/root-ca.pem
WAZUH_CA_FILE=
# one or more times, comma separated: 07:50,19:50
SCHEDULE_TIME=07:30
SCHEDULE_DAYS=mon,tue,wed,thu,fri
HIGH_LEVEL=7
# HEALTH_ACCEPT=vuln_overdue        # known warning flags: shown as accepted, health stays ok
# IGNORE_AGENTS=old-web01,*-laptop  # left out of the "agents not active" flag
# fallback window when there is no previous report (12 with a twice-daily schedule); the gap
# since the last report is used as it is, up to WINDOW_MAX_HOURS
WINDOW_MIN_HOURS=24
REDACT=false
# Optional: "Approve and deploy" for rule drafts (off by default; docs/rule-deployment.md).
# Needs a SEPARATE Wazuh API user that may only update the one rules file and restart the manager.
RULE_DEPLOY_ENABLED=false
WAZUH_DEPLOY_USER=
WAZUH_DEPLOY_PASSWORD=
RULE_DEPLOY_FILE=wdt_rules.xml
RULE_DEPLOY_ID_MIN=100000
RULE_DEPLOY_ID_MAX=119999
# Fail closed: require logtest samples before a draft may be deployed (docs/rule-deployment.md)
RULE_DEPLOY_REQUIRE_TESTS=false
# true = also deploy samples logtest cannot reproduce ("inconclusive"); off = fail closed
RULE_DEPLOY_ALLOW_INCONCLUSIVE=false

# ---------------------------------------------------------------- multi environment (environments.yaml)
# PROD_INDEXER_USER=daily-triage
# PROD_INDEXER_PASSWORD=
# PROD_API_USER=daily-triage
# PROD_API_PASSWORD=
