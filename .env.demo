# Demo: synthetic data, no Wazuh and no model needed.
#   cp .env.demo .env && docker compose up -d --build
# then open http://127.0.0.1:8080 and sign in with APP_PASSWORD below.
# Never use this file for a real installation: start from .env.example instead.
WDT_DEMO=true
LLM_PROVIDER=mock
APP_PASSWORD=demo-password-change-me
APP_LANGUAGE=en
TZ=UTC
ENVIRONMENT=development
COOKIE_SECURE=false
